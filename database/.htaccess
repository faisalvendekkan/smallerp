# Deny all web access to this directory.
#
# Defence in depth: the root .htaccess already forwards requests into public/,
# and on a correctly configured host the document root points at public/ so
# this directory is not reachable at all. This file means that even if the
# document root is misconfigured, nothing here can be fetched over HTTP --
# which matters most for storage/, where the SQLite database lives.

<IfModule mod_authz_core.c>
    # Apache 2.4+
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes
