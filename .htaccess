# If the document root could not be pointed at /public (common on basic shared
# hosting), this forwards requests into it and keeps app code unreachable.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|database|storage|views|tests)/ - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Never serve a database file or a config file, wherever it ends up.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
